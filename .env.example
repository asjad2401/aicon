# AI provider: "vertex" (default) or "gemini-api"
AI_PROVIDER=vertex

# Vertex AI
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# Service account key (raw JSON or base64). Leave empty locally to use
# Application Default Credentials (`gcloud auth application-default login`).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Gemini Developer API (only if AI_PROVIDER=gemini-api)
GEMINI_API_KEY=

# Optional model overrides
AI_MODEL_FAST=gemini-2.5-flash
AI_MODEL_FASTEST=gemini-2.5-flash-lite
AI_MODEL_SMART=gemini-3.1-pro-preview
AI_MODEL_FALLBACK=gemini-2.5-flash-lite
AI_TIMEOUT_MS=15000
