6399999838322401, 0.008100000210106373]}, {"text": "Mera chacha ciggarrete bohat peetey hain, ab unko khansi ke saath bohot ziada khoon nikal raha hai. Lagta hai serious hai.", "disc": [0.0405, 0.0137, 0.0029, 0.0003, 0.0259, 0.0005, 0.0194, 0.8013, 0.0032, 0.0037, 0.005, 0.0011, 0.0022, 0.0009, 0.0024, 0.005, 0.3342, 0.0096, 0.0004, 0.2214, 0.0145, 0.0018, 0.0093, 0.018, 0.01, 0.0025, 0.4817, 0.002, 0.0137, 0.0048], "dept": [0.02449999935925007, 0.047600001096725464, 0.05889999866485596, 0.032600000500679016, 0.031199999153614044, 0.06889999657869339, 0.4724000096321106, 0.013100000098347664, 0.1915999948978424, 0.05920000001788139]}, {"text": "میری جلد پر خارش کرنے سے بہت چھوٹے چھوٹے دانے ہو جاتے ہیں اور کبھی خون بھی نکل آتا ہے۔", "disc": [0.0051, 0.0017, 0.0038, 0.0019, 0.0114, 0.0012, 0.0034, 0.0402, 0.0009, 0.0012, 0.0021, 0.0027, 0.0023, 0.003, 0.0115, 0.0257, 0.0092, 0.0032, 0.0007, 0.0041, 0.0036, 0.0031, 0.0127, 0.0007, 0.0016, 0.0018, 0.0047, 0.0014, 0.0106, 0.0103], "dept": [0.00039999998989515007, 0.003000000026077032, 0.9819999933242798, 0.0024999999441206455, 0.002400000113993883, 0.004000000189989805, 0.002899999963119626, 0.0006000000284984708, 0.0013000000035390258, 0.0010999999940395355]}, {"text": "Baba ko bavaseer (hemorrhoids) hai, unko toilet mein khoon aata hai occasionally, lekin abhi theek hain, no active bleeding.", "disc": [0.0076, 0.0011, 0.0008, 0.0006, 0.0017, 0.0045, 0.0048, 0.0107, 0.0027, 0.0011, 0.0008, 0.0008, 0.002, 0.0005, 0.0026, 0.2135, 0.1985, 0.0031, 0.0017, 0.0023, 0.0092, 0.0019, 0.0101, 0.0095, 0.0095, 0.0099, 0.0021, 0.0019, 0.0802, 0.0003], "dept": [0.01940000057220459, 0.23909999430179596, 0.013899999670684338, 0.041600000113248825, 0.031300000846385956, 0.07440000027418137, 0.19750000536441803, 0.020600000396370888, 0.11060000211000443, 0.2515999972820282]}, {"text": "I pricked my finger to check my sugar, and it bled a lot, but I put pressure and it's fine now.", "disc": [0.0039, 0.0022, 0.0018, 0.0014, 0.0184, 0.002,