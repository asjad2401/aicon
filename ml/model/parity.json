[{"text": "میری بیگم کو صبح سے پیٹ میں شدید درد ہو رہا ہے۔ وہ چیخ رہی ہے اور کچھ کھا پی بھی نہیں سکی۔ لگتا ہے اپینڈکس کا مسئلہ ہے۔", "disc": [0.9882, 0.0506, 0.0015, 0.0007, 0.0005, 0.0007, 0.0404, 0.0115, 0.0045, 0.0259, 0.0036, 0.0008, 0.0242, 0.0048, 0.0026, 0.0002, 0.0272, 0.0024, 0.0166, 0.0804, 0.7315, 0.0032, 0.0121, 0.0212, 0.0159, 0.0038, 0.0901, 0.0027, 0.0042, 0.8411], "dept": [0.0027000000700354576, 0.003000000026077032, 0.0005000000237487257, 0.00800000037997961, 0.002099999925121665, 0.8615999817848206, 0.1111999973654747, 0.005499999970197678, 0.0026000000070780516, 0.0026000000070780516]}, {"text": "Meri bachi ki aankh me kuch gir gaya hai. Wo roye ja rahi hai, kehti hai churi chub rahi hai. Boht lal bhi ho gayi hai.", "disc": [0.0036, 0.0256, 0.0122, 0.0053, 0.0039, 0.014, 0.0049, 0.0021, 0.0374, 0.0015, 0.006, 0.0176, 0.005, 0.0216, 0.0415, 0.0013, 0.0335, 0.0082, 0.0819, 0.0108, 0.0056, 0.0093, 0.0065, 0.0037, 0.0701, 0.001, 0.0357, 0.0043, 0.0026, 0.0168], "dept": [0.0027000000700354576, 0.0032999999821186066, 0.006000000052154064, 0.013000000268220901, 0.8658999800682068, 0.004900000058114529, 0.04309999942779541, 0.03370000049471855, 0.00989999994635582, 0.01759999990463257]}, {"text": "میرے والد صاحب کو اچانک ٹانگ میں بہت تیز درد ہوا ہے، اور اب وہ ٹھنڈی پڑ گئی ہے۔", "disc": [0.0407, 0.0049, 0.0117, 0.0016, 0.0011, 0.0069, 0.0151, 0.0043, 0.0012, 0.0009, 0.0064, 0.015, 0.1219, 0.0196, 0.0063, 0.0012, 0.0067, 0.0298, 0.0266, 0.0019, 0.0126, 0.006, 0.0192, 0.2118, 0.0329, 0.0096, 0.0234, 0.174, 0.0083, 0.0012], "dept": [0.07819999754428864, 0.012799999676644802, 0.016200000420212746, 0.008299999870359898, 0.007600000128149986, 0.00839999970048666, 0.4708000123500824, 0.30410000681877136, 0.014499999582767487, 0.07909999787807465]}, {"text": "Mera shohar khansi karte hue gilaas mein khoon dekh kar darr gaya. Kehta hai chest mein dard bhi hai.", "disc": [0.0199, 0.0063, 0.0133, 0.0044, 0.0024, 0.001, 0.3167, 0.5478, 0.0019, 0.0013, 0.0093, 0.001, 0